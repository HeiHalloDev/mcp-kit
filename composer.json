{
    "name": "heihallo/mcp-kit",
    "description": "Staff tooling over MCP for Laravel apps: ability catalogue, per-person tokens, access and audit middleware, preview/confirm writes, ground rules, per-user assistant memory and onboarding.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mcp", "sanctum", "activitylog", "staff-tools", "ai"],
    "authors": [
        {"name": "HeiHallo", "email": "hello@heihallo.com"}
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^0.9",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-activitylog": "^4.9|^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "spatie/laravel-permission": "^6.0|^8.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Lets the kit read roles and permissions from spatie (SpatiePermissionChecker, SpatieRolesDescriber).",
        "livewire/livewire": "Required by the optional tokens page and the assistant-memory component (mcp-kit.ui.*).",
        "livewire/flux": "The optional UI renders with Flux components; the tokens page also uses Flux Pro's table and tabs."
    },
    "autoload": {
        "psr-4": {
            "HeiHallo\\McpKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HeiHallo\\McpKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HeiHallo\\McpKit\\McpKitServiceProvider"
            ],
            "aliases": {
                "McpKit": "HeiHallo\\McpKit\\Facades\\McpKit"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint"
    }
}
